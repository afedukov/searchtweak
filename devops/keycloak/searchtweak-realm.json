{
  "realm": "searchtweak",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "searchtweak-app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "searchtweak-local-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://searchtweak.local/auth/oidc/callback"
      ],
      "webOrigins": [
        "http://searchtweak.local"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://searchtweak.local/*"
      }
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "testuser@searchtweak.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "testuser",
          "temporary": false
        }
      ]
    }
  ]
}
